# Copy to .env and fill in what you have. Every key is optional.
# .env is git-ignored — never commit real keys.

# Gemini prompt enhancement + storyboard scripts (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Comma-separated model fallback order (default: gemini-2.5-flash,gemini-2.5-flash-lite)
GEMINI_MODELS=

# Hugging Face token: higher ZeroGPU quota for the LTX / CogVideoX / Wan Spaces
HF_TOKEN=

# Stock footage / photos for storyboard scenes and the no-GPU fallback
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Put render output outside OneDrive (cloud sync locks files mid-encode)
# VIDEOSTUDIO_OUTPUT_DIR=C:\Users\you\Videos\VideoStudio
